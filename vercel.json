{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "dentiligence-api",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/main.py"
    }
  ],
  "env": {
    "MODEL_WEIGHTS_PATH": "@dentiligence_model_weights_path",
    "PYTHONPATH": "."
  },
  "regions": ["iad1"],
  "functions": {
    "api/main.py": {
      "maxDuration": 60,
      "memory": 3009,
      "runtime": "@vercel/python"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "X-Powered-By",              "value": "Dentiligence/0.1.0" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}
